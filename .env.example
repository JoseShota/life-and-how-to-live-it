# Copy to .env.local (git-ignored) for `npm run dev`, and set the same two variables in Vercel.
# Both values are public by design (the anon/publishable key only reaches the sync functions, for the signed-in
# user's own rows). Never put the service_role / secret key here or anywhere in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
